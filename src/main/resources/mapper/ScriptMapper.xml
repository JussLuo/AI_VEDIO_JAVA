<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ai168.vedio.mapper.ScriptMapper">
    <resultMap id="ScriptResultMap" type="com.ai168.vedio.entity.Script">
        <id property="id" column="id"/>
        <result property="projectId" column="project_id"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>
    <insert id="insert">
        INSERT INTO scripts (id, project_id, title, content, status, created_at, updated_at)
        VALUES (#{id}, #{projectId}, #{title}, #{content}, #{status}, #{createdAt}, #{updatedAt})
    </insert>
    <select id="selectByProjectId" resultMap="ScriptResultMap">
        SELECT * FROM scripts WHERE project_id = #{projectId}
        ORDER BY created_at DESC, id DESC
    </select>
    <select id="selectById" resultMap="ScriptResultMap">
        SELECT * FROM scripts WHERE id = #{id}
    </select>
    <update id="update">
        UPDATE scripts
        SET title=#{title}, content=#{content}, status=#{status}, updated_at=#{updatedAt}
        WHERE id=#{id}
    </update>
    <delete id="deleteById">
        DELETE FROM scripts WHERE id=#{id}
    </delete>
</mapper>
